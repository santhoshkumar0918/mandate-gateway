# Razorpay test-mode API keys
# Get these from https://dashboard.razorpay.com/ → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Master secret that encrypts the gateway's mandate signing key at rest.
# Generate a strong random value, e.g. `openssl rand -hex 32`, and keep it
# secret — it is never stored in the database or committed. A lost/rotated
# master key cannot be recovered (the signing key is unrecoverable).
MANDATE_MASTER_KEY=replace-with-a-64-char-hex-secret

# Database
DATABASE_URL=postgres://gateway:gateway_dev@localhost:5432/mandate_gateway

# Buyer agent config
GATEWAY_URL=http://localhost:8000
BUDGET=50000
CATEGORY=electronics
